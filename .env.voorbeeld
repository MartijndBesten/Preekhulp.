# Kopieer naar .env.local en vul alleen in wat je gebruikt. Dit bestand nooit committen.
# Sleutels kunnen ook via Instellingen in de app worden ingevoerd (opgeslagen in .data/, buiten Git).

# AI-aanbieders (allemaal optioneel; zonder AI werkt de bron- en tekstlaag gewoon)
PREEKHULP_ANTHROPIC_KEY=
PREEKHULP_OPENAI_KEY=
PREEKHULP_OLLAMA_URL=http://127.0.0.1:11434

# Bronnen (optioneel)
PREEKHULP_YOUTUBE_KEY=
PREEKHULP_CORE_KEY=
PREEKHULP_OPENALEX_KEY=
PREEKHULP_SEMANTIC_SCHOLAR_KEY=
PREEKHULP_GOOGLE_BOOKS_KEY=
# Unpaywall en het 'polite pool' van Crossref/OpenAlex vragen om een contactadres:
PREEKHULP_CONTACT_EMAIL=

# Map voor database, uploads en brondata (standaard ./.data)
PREEKHULP_DATA_DIR=
